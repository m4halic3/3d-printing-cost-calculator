<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox spacing="25" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistema3d.MainController" style="-fx-padding: 30; -fx-background-color: #0F172A; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;">
    
    <VBox spacing="16" prefWidth="360" HBox.hgrow="ALWAYS">
        <Label text="Configurações do Projeto" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #F8FAFC;"/>
        <Separator style="-fx-opacity: 0.1;"/>
        
        <VBox spacing="6">
            <Label text="IMPRESSORA 3D" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
            <ComboBox fx:id="comboImpressora" prefWidth="360" onAction="#handleImpressoraSelecionada" 
                      style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 5; -fx-text-fill: white;"/>
        </VBox>
        
        <VBox spacing="6">
            <Label text="NOME DO ARQUIVO STL" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
            <TextField fx:id="txtNomeArquivo" text="suporte-celular.stl" 
                       style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10; -fx-text-fill: #F1F5F9;"/>
        </VBox>
        
        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="PESO (G)" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
                <TextField fx:id="txtMaterialGramas" text="120" 
                           style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10; -fx-text-fill: #F1F5F9;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="TEMPO (HORAS)" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
                <TextField fx:id="txtTempoHoras" text="5" 
                           style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 10; -fx-text-fill: #F1F5F9;"/>
            </VBox>
        </HBox>
        
        <VBox spacing="6">
            <Label text="MATERIAL DE IMPRESSÃO" style="-fx-text-fill: #38BDF8; -fx-font-weight: bold; -fx-font-size: 10px; -fx-letter-spacing: 1px;"/>
            <ComboBox fx:id="comboMaterial" prefWidth="360" 
                      style="-fx-background-color: #1E293B; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 5;"/>
        </VBox>
        
        <VBox spacing="10" style="-fx-padding: 10 0 10 0;">
            <CheckBox fx:id="chkFalha" text="Adicionar margem de perda (+10%)" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
            <CheckBox fx:id="chkMargem" text="Aplicar margem de lucro comercial (30%)" selected="true" style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
        </VBox>
        
        <Button text="Calcular Custos" onAction="#handleCalcular" prefWidth="360" 
                style="-fx-background-color: #0EA5E9; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 12; -fx-cursor: hand;"/>
    </VBox>

    <Separator orientation="VERTICAL" style="-fx-opacity: 0.1;"/>

    <VBox spacing="15" prefWidth="410" alignment="TOP_CENTER" HBox.hgrow="ALWAYS">
        <Label text="Painel de Controle" style="-fx-font-weight: bold; -fx-font-size: 20px; -fx-text-fill: #F8FAFC;"/>
        
        <VBox alignment="CENTER" style="-fx-background-color: #1E293B; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;" prefHeight="200" prefWidth="410">
            <ImageView fx:id="imgImpressora" fitWidth="180" fitHeight="180" preserveRatio="true"/>
        </VBox>
        
        <Label fx:id="lblDescricao" wrapText="true" style="-fx-font-style: italic; -fx-text-alignment: center; -fx-text-fill: #94A3B8; -fx-font-size: 12px;" minHeight="40"/>
        
        <GridPane hgap="15" vgap="12" style="-fx-background-color: #1E293B; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #334155; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="180"/>
                <ColumnConstraints hgrow="NEVER" halignment="RIGHT" minWidth="120"/>
            </columnConstraints>
            
            <Label text="Custo de Insumo:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #94A3B8;"/>
            <Label fx:id="lblCustoMaterial" text="R$ 0,00" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #F1F5F9;"/>
            
            <Label text="Depreciação de Máquina:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #94A3B8;"/>
            <Label fx:id="lblCustoMaquina" text="R$ 0,00" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #F1F5F9;"/>
            
            <Label text="Consumo de Energia:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #94A3B8;"/>
            <Label fx:id="lblCustoEnergia" text="R$ 0,00" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #F1F5F9;"/>
            
            <Label text="Mão de Obra Alocada:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #94A3B8;"/>
            <Label fx:id="lblCustoMaoObra" text="R$ 0,00" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #F1F5F9;"/>
            
            <Label text="Fundo de Manutenção:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #94A3B8;"/>
            <Label fx:id="lblCustoManutencao" text="R$ 0,00" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #F1F5F9;"/>
            
            <Separator GridPane.rowIndex="5" GridPane.columnSpan="2" style="-fx-opacity: 0.1; -fx-padding: 5 0 5 0;"/>
            
            <Label text="CUSTO OPERACIONAL:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #c12b2b;"/>
            <Label fx:id="lblCustoTotal" text="R$ 0,00" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #b40101;"/>
            
            <Label text="PREÇO DE VENDA:" GridPane.rowIndex="7" GridPane.columnIndex="0" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34D399;"/>
            <Label fx:id="lblPrecoVenda" text="R$ 0,00" GridPane.rowIndex="7" GridPane.columnIndex="1" style="-fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #00a46d;"/>
        </GridPane>
    </VBox>
</HBox>